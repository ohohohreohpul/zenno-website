# Zenno marketing site — Apache / Hostinger rules for the static export (out/).
# German is the primary locale at "/"; English lives at /en/, Thai at /th/.
RewriteEngine On

# One canonical host: https://www.zennohq.com (always www, always HTTPS),
# matching SITE_URL and the Vercel domain setup.
# zennohq.studio is retired: send it to the same path on www.zennohq.com.
RewriteCond %{HTTP_HOST} ^(www\.)?zennohq\.studio$ [NC]
RewriteRule ^ https://www.zennohq.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^zennohq\.com$ [NC]
RewriteRule ^ https://www.zennohq.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Old German URLs moved to the root.
RewriteRule ^de/?$ / [R=301,L]
RewriteRule ^de/booking/?$ /booking/ [R=301,L]

# The ManyChat/DMChamp comparison was retired for the commission-free page.
RewriteRule ^comparison/?$ /commission-free/ [R=301,L]
RewriteRule ^en/comparison/?$ /en/commission-free/ [R=301,L]

ErrorDocument 404 /404.html

# Open Graph images are exported without a file extension; serve them as PNG
# so link previews (WhatsApp, LinkedIn, Slack, X) accept them.
<FilesMatch "^opengraph-image">
  ForceType image/png
</FilesMatch>
